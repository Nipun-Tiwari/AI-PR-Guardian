generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InstallationStatus {
  active
  removed
}

enum ReviewJobStatus {
  pending
  running
  succeeded
  failed
}

model User {
  id             String   @id @default(uuid())
  githubUserId   BigInt   @unique @map("github_user_id")
  githubUsername String   @map("github_username")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  sessions                Session[]
  repositories            Repository[]
  repositoryInstallations RepositoryInstallation[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String   @map("user_id")
  data      Json
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Repository {
  id                   String   @id @default(uuid())
  githubRepositoryId   BigInt   @unique @map("github_repository_id")
  githubInstallationId BigInt   @map("github_installation_id")
  owner                String
  name                 String
  fullName             String   @map("full_name")
  isActive             Boolean  @default(true) @map("is_active")
  ownedByUserId        String?  @map("owned_by_user_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  ownerUser User?    @relation(fields: [ownedByUserId], references: [id])
  reviews   Review[]

  @@index([githubInstallationId])
  @@index([ownedByUserId])
  @@map("repositories")
}

model RepositoryInstallation {
  id                   String             @id @default(uuid())
  githubInstallationId BigInt             @unique @map("github_installation_id")
  githubAccountId      BigInt             @map("github_account_id")
  githubAccountLogin   String             @map("github_account_login")
  createdByUserId      String?            @map("created_by_user_id")
  status               InstallationStatus @default(active)
  installedAt          DateTime           @map("installed_at")
  removedAt            DateTime?          @map("removed_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  createdByUser User? @relation(fields: [createdByUserId], references: [id])

  @@index([githubAccountId])
  @@index([createdByUserId])
  @@map("repository_installations")
}

model WebhookDelivery {
  id               String   @id @default(uuid())
  githubDeliveryId String   @unique @map("github_delivery_id")
  event            String
  action           String?
  receivedAt       DateTime @default(now()) @map("received_at")

  @@index([receivedAt])
  @@map("webhook_deliveries")
}

model ReviewJob {
  id             String          @id @default(uuid())
  status         ReviewJobStatus @default(pending)
  installationId BigInt          @map("installation_id")
  repositoryId   BigInt          @map("repository_id")
  prNumber       Int             @map("pr_number")
  headSha        String          @map("head_sha")
  attempts       Int             @default(0)
  maxAttempts    Int             @default(3) @map("max_attempts")
  leaseExpiresAt DateTime?       @map("lease_expires_at")
  errorMessage   String?         @map("error_message")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  completedAt    DateTime?       @map("completed_at")

  reviews Review[]

  @@index([status, leaseExpiresAt])
  @@index([createdAt])
  @@map("review_jobs")
}

enum ReviewMode {
  demo
  live
}

enum ReviewStatus {
  queued
  running
  succeeded
  failed
  cancelled
  partial
}

enum FindingSource {
  demo_fixture
  static_rule
  llm
}

enum FindingCategory {
  security
  bug
  error_handling
  performance
  test_coverage
  style
}

enum FindingSeverity {
  critical
  high
  medium
  low
  info
}

enum FindingConfidence {
  high
  medium
  low
}

enum FindingValidationStatus {
  valid
  invalid_location
  low_confidence
  rejected
}

model Review {
  id                 String       @id @default(uuid())
  mode               ReviewMode   @default(live)
  status             ReviewStatus @default(queued)
  repositoryId       String?      @map("repository_id")
  githubRepositoryId BigInt       @map("github_repository_id")
  owner              String
  name               String
  prNumber           Int          @map("pr_number")
  prTitle            String       @map("pr_title")
  prUrl              String?      @map("pr_url")
  headSha            String       @map("head_sha")
  jobId              String?      @map("job_id")
  findingsTotal      Int          @default(0) @map("findings_total")
  findingsCritical   Int          @default(0) @map("findings_critical")
  findingsHigh       Int          @default(0) @map("findings_high")
  findingsMedium     Int          @default(0) @map("findings_medium")
  findingsLow        Int          @default(0) @map("findings_low")
  findingsInfo       Int          @default(0) @map("findings_info")
  errorMessage       String?      @map("error_message")
  startedAt          DateTime?    @map("started_at")
  completedAt        DateTime?    @map("completed_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  job        ReviewJob?  @relation(fields: [jobId], references: [id], onDelete: SetNull)
  findings   Finding[]

  @@index([repositoryId, createdAt])
  @@index([jobId])
  @@index([githubRepositoryId, prNumber, headSha])
  @@map("reviews")
}

model Finding {
  id               String                  @id @default(uuid())
  reviewId         String                  @map("review_id")
  source           FindingSource
  category         FindingCategory
  severity         FindingSeverity
  confidence       FindingConfidence
  filePath         String                  @map("file_path")
  lineStart        Int                     @map("line_start")
  lineEnd          Int?                    @map("line_end")
  message          String
  evidence         String?
  recommendation   String?
  validationStatus FindingValidationStatus @map("validation_status")
  fingerprint      String
  createdAt        DateTime                @default(now()) @map("created_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([fingerprint])
  @@map("findings")
}
